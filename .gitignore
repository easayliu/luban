# Rust build artifacts
/target

# Backtrace/debug symbols
*.pdb

# 前端依赖与构建产物（构建前需在 admin-ui 执行 pnpm install && pnpm build）
/admin-ui/node_modules
/admin-ui/dist

# pnpm 的本地内容寻址 store 与调试日志。store 只对本机有意义（装依赖时自动重建），
# 且平时是空目录、git 不会提示，一旦 pnpm 往里写了东西又碰上 `git add -A` 就会被整个卷进来。
# `node_modules/.pnpm` 已被上面的 node_modules 规则覆盖。
/.pnpm-store
.pnpm-debug.log*

# SQLite 凭证库（含 WAL/SHM）
*.db
*.db-wal
*.db-shm
/config/

# env file
.env

# HTTPS 隧道抓包（对齐官方客户端形态时的基准样本，含真实请求头与 token，不入库）
/cap/

# Editor/IDE
# .idea/
# .vscode/

# TS 增量构建缓存
/admin-ui/tsconfig.tsbuildinfo
